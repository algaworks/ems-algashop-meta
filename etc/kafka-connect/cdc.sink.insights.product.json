{
  "name": "cdc.sink.insights.product",
  "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
  "tasks.max": "1",
  "connection.url": "${ssm::/config/algashop/kafka-connect/insights-database/connection-url}?stringtype=unspecified",
  "connection.username": "${secretsmanager:/secret/algashop/kafka-connect/insights-database:username}",
  "connection.password": "${secretsmanager:/secret/algashop/kafka-connect/insights-database:password}",
  "topics": "cdc.product_catalog.products",
  "collection.name.format": "product",
  "insert.mode": "upsert",
  "primary.key.mode": "record_key",
  "schema.evolution": "none",
  "delete.enabled": "true",
  "field.exclude.list": "category_enabled,discount_percentage_rounded,main_image_id,main_image_name",
  "transforms": "snake",
  "transforms.snake.type": "io.debezium.connector.jdbc.transforms.FieldNameTransformation",
  "transforms.snake.column.naming.style": "snake_case"
}