  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.outbox.table.fields.additional.placement": "message_type:header:__TypeId__,id:header:idempotency-key,correlation_id:header:kafka_correlationId,reply_topic:header:kafka_replyTopic",
  "extended.headers.enabled": "false"
